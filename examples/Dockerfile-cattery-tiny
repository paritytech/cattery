# Minimal runner image for the docker provider. Build from the repository root:
#   docker build -t cattery-runner-tiny:latest -f examples/Dockerfile-cattery-tiny .
#
# The docker provider starts the container with
#   /action-runner/cattery/cattery agent -i <tray-id> -s <advertiseUrl> --runner-folder /action-runner
# so the agent binary and the GitHub Actions runner must live at those paths.

ARG GO_VERSION=1.26

FROM golang:${GO_VERSION} AS build
WORKDIR /cattery
COPY src/ .
RUN CGO_ENABLED=0 go build -o /out/cattery .

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /action-runner

ARG RUNNER_VERSION='2.333.0'
# Set by BuildKit to the architecture the image is built for (amd64, arm64).
# The Actions runner calls amd64 "x64".
ARG TARGETARCH
RUN RUNNER_ARCH="$([ "${TARGETARCH}" = "amd64" ] && echo x64 || echo "${TARGETARCH}")" \
    && curl -fsSL -o actions-runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz" \
    && tar xzf actions-runner.tar.gz \
    && rm actions-runner.tar.gz \
    && ./bin/installdependencies.sh

COPY --from=build /out/cattery /action-runner/cattery/cattery
